[Unit]
Description=Bubble Craps Dice Rolling Machine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lucky
WorkingDirectory=/home/lucky/bubble-craps
ExecStart=/home/lucky/bubble-craps/venv/bin/python -m bubble_craps.main
Restart=on-failure
RestartSec=5

# Environment
Environment=PYTHONPATH=/home/lucky/bubble-craps/src

# CAN bus needs root for setup, but the app runs as lucky.
# Make sure the can0 interface is brought up before this service starts
# (e.g. via /etc/network/interfaces or a separate systemd-networkd config).

# Logging goes to journald — view with: journalctl -u bubble-craps -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
